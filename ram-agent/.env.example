# Adresse IP de CE nœud (agent P2P + API Proxmox sur le même serveur)
NODE_IP=192.168.X.X

# Nom d'utilisateur Proxmox (format user@realm)
PROXMOX_USER=root@pam

# Nom et valeur du token Proxmox
PROXMOX_TOKEN_NAME=your-token-name
PROXMOX_TOKEN_VALUE=your-token-uuid

# Nom du node Proxmox ciblé (si absent, tous les nodes sont interrogés)
PROXMOX_NODE=pve

# Liste des IPs des nœuds voisins (séparées par des virgules)
PEER_IPS=192.168.X.X,192.168.X.Y,192.168.X.Z

# Port RPC local
RPC_PORT=7878
